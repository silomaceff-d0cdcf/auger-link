<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Phase 2: Reticulum + LXMF networking. INTERNET is required for
        AutoInterface to bind a multicast socket and to send / receive
        LXMF messages. ACCESS_NETWORK_STATE is required for
        java.net.NetworkInterface enumeration on Android — without it
        the AutoInterface caller-provides-indexes patch can't resolve
        wlan0's kernel index and AutoInterface fails to come up.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
        AutoInterface uses link-local IPv6 multicast for peer discovery.
        Android silently filters multicast traffic to apps in user space
        unless they hold a WifiManager.MulticastLock — without this
        permission, every multicast send fails with EPERM and AutoInterface
        spams "carrier loss" warnings on every announce attempt.
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AugerLink"
        tools:targetApi="35"
        xmlns:tools="http://schemas.android.com/tools">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AugerLink">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
