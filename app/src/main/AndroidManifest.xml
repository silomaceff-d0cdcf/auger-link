<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Phase 2: Reticulum + LXMF networking. INTERNET is required for
        AutoInterface to bind a multicast socket and to send / receive
        LXMF messages. ACCESS_NETWORK_STATE is required for
        java.net.NetworkInterface enumeration on Android — without it
        the AutoInterface caller-provides-indexes patch can't resolve
        wlan0's kernel index and AutoInterface fails to come up.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
        AutoInterface uses link-local IPv6 multicast for peer discovery.
        Android silently filters multicast traffic to apps in user space
        unless they hold a WifiManager.MulticastLock — without this
        permission, every multicast send fails with EPERM and AutoInterface
        spams "carrier loss" warnings on every announce attempt.
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!--
        Foreground service permissions: required so AugerLink can run an
        AugerLinkService while the activity is backgrounded. Without a
        foreground service, Android filters outbound IPv6 multicast egress
        for apps in normal-background importance — AutoInterface's announce
        sendto returns EPERM at ~50% rate. Promoting the app to foreground
        importance via a persistent service notification lifts the filter.
        DATA_SYNC is the appropriate foregroundServiceType for the
        Reticulum router (always-on bidirectional packet exchange).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        Phase 6a: voice features. RECORD_AUDIO is the runtime permission
        that gates the mic capture pipeline. FOREGROUND_SERVICE_MICROPHONE
        lets the always-on AugerLinkService hold the mic for wake-word
        detection without being throttled in the background — without it,
        Android 14+ throws ForegroundServiceTypeException when the service
        starts listening.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!--
        Phase 5 completion: auto-start the Reticulum router after device
        reboot so inbound LXMF delivery resumes without requiring the user
        to open the app first. On Android 11+ the user must launch the app
        at least once before BOOT_COMPLETED is delivered (OS privacy gate).
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AugerLink"
        tools:targetApi="35"
        xmlns:tools="http://schemas.android.com/tools">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AugerLink">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground service: lifts Android's background-multicast-egress
             filter so AutoInterface announces actually transit. Phase 5
             migrated the Reticulum router lifecycle into here — service
             owns init, identity, MulticastLock, and the receive loop. -->
        <!-- foregroundServiceType="dataSync|microphone": dataSync remains the
             primary justification (Reticulum + LXMF always-on packet
             exchange); microphone is added for Phase 6a's wake-word listener
             which the service hosts so it can be active while the activity
             is backgrounded. Both types are mandatory under Android 14+
             when the service uses each capability. -->
        <service
            android:name=".comms.AugerLinkService"
            android:exported="false"
            android:foregroundServiceType="dataSync|microphone" />

        <!-- Phase 5 completion: BOOT_COMPLETED auto-starts the service so
             inbound LXMF delivery resumes after a reboot without requiring
             the user to open the app first. -->
        <receiver
            android:name=".comms.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
